/* =====================================================================
   D-Clinic — Professional Medical Theme  (Light / Dark)

   This file is a TEMPLATE: the placeholders below are substituted at runtime
   by app/services/theme.py with the active palette (Light or Dark). The teal
   brand accent (#0E9F8E) and the dark sidebar are deliberately identical in
   both modes. Edit colours in theme.py, not here.

   Font: Vazirmatn (bundled)
   ===================================================================== */

* {
    font-family: "Vazirmatn", "Segoe UI", "Tahoma", sans-serif;
    font-size: 15px;
    outline: none;
}

QWidget {
    color: {{text}};
    background-color: {{bg}};
}

/* Plain labels inherit the theme text colour so they stay readable when the
   surface flips to dark (inline-styled labels override this as needed). */
QLabel { color: {{text}}; background: transparent; }

QToolTip {
    background-color: {{tooltip_bg}};
    color: {{tooltip_fg}};
    border: none;
    padding: 6px 10px;
    border-radius: 6px;
}

/* ---------------- Sidebar (brand-dark in both themes) ---------------- */
#Sidebar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                stop:0 #0C2A33, stop:1 #103E46);
    border: none;
}
#Sidebar QLabel#BrandTitle {
    color: #ffffff;
    font-size: 22px;
    font-weight: 700;
    padding: 4px 6px;
    background: transparent;
}
#Sidebar QLabel#BrandSub {
    color: #7FB8B2;
    font-size: 12px;
    padding: 0 6px;
    background: transparent;
}
#Sidebar QFrame#NavSep {
    background-color: rgba(255,255,255,0.08);
    max-height: 1px;
    border: none;
}
QScrollArea#NavScroll, QWidget#NavScroll { background: transparent; border: none; }
QPushButton#NavButton {
    color: #C9DDDB;
    background-color: transparent;
    border: none;
    border-radius: 12px;
    padding: 13px 16px;
    text-align: right;
    font-size: 15px;
    font-weight: 500;
}
QPushButton#NavButton:hover {
    background-color: rgba(255,255,255,0.07);
    color: #ffffff;
}
QPushButton#NavButton:checked {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                stop:0 #11B5A2, stop:1 #0E9F8E);
    color: #ffffff;
    font-weight: 700;
}
QPushButton#NavLogout {
    color: #F1A8B4;
    background-color: transparent;
    border: none;
    border-radius: 12px;
    padding: 13px 16px;
    text-align: right;
    font-weight: 500;
}
QPushButton#NavLogout:hover { background-color: rgba(226,61,91,0.18); color:#ffffff; }

/* ---------------- Header ---------------- */
#Header {
    background-color: {{surface}};
    border: none;
    border-bottom: 1px solid {{border}};
}
#Header QLabel#PageTitle {
    font-size: 22px;
    font-weight: 700;
    color: {{text}};
    background: transparent;
}
#Header QLabel#ClinicName {
    font-size: 15px;
    font-weight: 700;
    color: #0E9F8E;
    background: transparent;
}
#Header QLabel#UserChip {
    color: #ffffff;
    background-color: #0E9F8E;
    font-size: 13px;
    font-weight: 600;
    padding: 8px 14px;
    border-radius: 20px;
}

/* ---------------- Cards ---------------- */
QFrame#Card, QFrame#StatCard {
    background-color: {{surface}};
    border: 1px solid {{border}};
    border-radius: 16px;
}
QLabel#StatValue {
    font-size: 27px;
    font-weight: 700;
    color: {{text}};
    background: transparent;
}
QLabel#StatLabel {
    font-size: 13px;
    color: {{muted}};
    font-weight: 500;
    background: transparent;
}
QLabel#CardTitle {
    font-size: 17px;
    font-weight: 700;
    color: {{text}};
    background: transparent;
}
QLabel#SectionHint { color: {{muted}}; font-size: 13px; background: transparent; }

/* ---------------- Inputs ---------------- */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit,
QPlainTextEdit, QTextEdit {
    background-color: {{input_bg}};
    color: {{text}};
    border: 1px solid {{input_border}};
    border-radius: 10px;
    padding: 10px 12px;
    min-height: 22px;
    selection-background-color: #0E9F8E;
    selection-color: #ffffff;
}
QLineEdit:hover, QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover,
QDateEdit:hover, QPlainTextEdit:hover, QTextEdit:hover {
    border: 1px solid {{input_border_hover}};
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QDateEdit:focus, QPlainTextEdit:focus, QTextEdit:focus {
    border: 1px solid #0E9F8E;
    background-color: {{input_focus_bg}};
}
QComboBox::drop-down { border: none; width: 26px; }
QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid {{muted}};
    margin-right: 8px;
}
QComboBox QAbstractItemView {
    background: {{surface}};
    color: {{text}};
    border: 1px solid {{input_border}};
    border-radius: 8px;
    padding: 4px;
    selection-background-color: {{sel_bg}};
    selection-color: {{sel_text}};
}
QLabel#FieldLabel { color: {{muted}}; font-weight: 600; font-size: 13px; background: transparent; }

/* ---------------- Buttons ---------------- */
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
               stop:0 #12B0A0, stop:1 #0E9F8E);
    color: #ffffff;
    border: none;
    border-radius: 10px;
    padding: 11px 20px;
    font-weight: 700;
    min-height: 20px;
}
QPushButton:hover { background: #0C8E7F; }
QPushButton:pressed { background: #0A7A6D; }
QPushButton:disabled { background: #AFCBC7; color: #EAF5F3; }

QPushButton#Secondary {
    background: {{secondary_bg}};
    color: {{secondary_text}};
    border: 1px solid {{input_border}};
}
QPushButton#Secondary:hover { background: {{secondary_hover}}; border-color:{{input_border_hover}}; }

QPushButton#Danger {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #EF4B66, stop:1 #E23D5B);
    color: #ffffff;
}
QPushButton#Danger:hover { background: #CC2C49; }

QPushButton#Success {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #18B86A, stop:1 #10A05B);
    color: #ffffff;
}
QPushButton#Success:hover { background: #0C8C4E; }

QPushButton#Ghost {
    background: transparent;
    color: #0E9F8E;
    border: 1px solid #9FD8D1;
}
QPushButton#Ghost:hover { background: {{sel_bg}}; }

QPushButton#IconBtn {
    background: {{secondary_bg}};
    color: {{secondary_text}};
    border: 1px solid {{input_border}};
    border-radius: 9px;
    padding: 7px;
    font-weight: 700;
}
QPushButton#IconBtn:hover { background:{{secondary_hover}}; }

/* ---------- Table action buttons (consistent, text-based) ---------- */
QPushButton#ActBtn, QPushButton#ActPrimary, QPushButton#ActDanger,
QPushButton#ActSuccess, QPushButton#ActWarn {
    border-radius: 8px;
    padding: 7px 14px;
    font-size: 13px;
    font-weight: 700;
    min-height: 20px;
    min-width: 30px;
}
QPushButton#ActBtn { background:{{secondary_bg}}; color:{{secondary_text}}; border:1px solid {{input_border}}; }
QPushButton#ActBtn:hover { background:{{secondary_hover}}; }
QPushButton#ActPrimary { background:#E3F6F3; color:#0A6B61; border:1px solid #A6DCD5; }
QPushButton#ActPrimary:hover { background:#D2EFEA; }
QPushButton#ActSuccess { background:#E7F7EE; color:#0C7A43; border:1px solid #B4E3C7; }
QPushButton#ActSuccess:hover { background:#D6F0E1; }
QPushButton#ActWarn { background:#FEF4E6; color:#A66617; border:1px solid #F3D9AC; }
QPushButton#ActWarn:hover { background:#FBE9CC; }
QPushButton#ActDanger { background:#FEF2F4; color:#B11334; border:1px solid #F6C9D2; }
QPushButton#ActDanger:hover { background:#FBE0E5; }

/* ---------------- Tables ---------------- */
QTableWidget, QTableView {
    background-color: {{surface}};
    alternate-background-color: {{table_header_bg}};
    color: {{text}};
    border: 1px solid {{border}};
    border-radius: 14px;
    gridline-color: {{gridline}};
    selection-background-color: {{sel_bg}};
    selection-color: {{sel_text}};
}
QHeaderView::section {
    background-color: {{table_header_bg}};
    color: {{muted}};
    padding: 13px 12px;
    border: none;
    border-bottom: 2px solid {{border}};
    font-weight: 700;
    font-size: 13px;
}
QTableWidget::item, QTableView::item { padding: 10px 8px; }
QTableWidget::item:selected { color: {{sel_text}}; }
QTableCornerButton::section { background: {{table_header_bg}}; border: none; }

/* ---------------- Tabs ---------------- */
QTabWidget::pane {
    border: 1px solid {{border}};
    border-radius: 14px;
    background: {{surface}};
    top: -1px;
}
QTabBar::tab {
    background: transparent;
    color: {{muted}};
    padding: 11px 22px;
    margin-left: 4px;
    border: none;
    border-bottom: 3px solid transparent;
    font-weight: 600;
}
QTabBar::tab:hover { color: #0E9F8E; }
QTabBar::tab:selected {
    color: #0E9F8E;
    border-bottom: 3px solid #0E9F8E;
    font-weight: 700;
}

/* ---------------- Scrollbars ---------------- */
QScrollBar:vertical { background: transparent; width: 12px; margin: 4px; }
QScrollBar::handle:vertical { background: {{scrollbar}}; border-radius: 6px; min-height: 36px; }
QScrollBar::handle:vertical:hover { background: {{scrollbar_hover}}; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
QScrollBar:horizontal { background: transparent; height: 12px; margin: 4px; }
QScrollBar::handle:horizontal { background: {{scrollbar}}; border-radius: 6px; min-width: 36px; }
QScrollBar::handle:horizontal:hover { background: {{scrollbar_hover}}; }

/* ---------------- Dialogs ---------------- */
QDialog { background-color: {{dialog_bg}}; }
QDialog QLabel { color: {{text}}; font-weight: 600; background: transparent; }
QMessageBox { background-color: {{surface}}; }
QMessageBox QLabel { color: {{text}}; background: transparent; }

/* Styled dialog header bar */
QFrame#DialogHeader {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                stop:0 #0C2A33, stop:1 #0E9F8E);
}
QFrame#DialogHeader QLabel { color: #ffffff; background: transparent; }
QLabel#DialogHeaderTitle { color: #ffffff; font-size: 17px; font-weight: 700; background: transparent; }
QLabel#DialogHeaderSub { color: #CFEFEA; font-size: 12px; font-weight: 500; background: transparent; }
QLabel#DialogHeaderIcon {
    background: rgba(255,255,255,0.18);
    border-radius: 12px;
    font-size: 22px;
}

/* Card wrapper for dialog form bodies */
QFrame#DialogBody {
    background: {{surface}};
    border: 1px solid {{border}};
    border-radius: 12px;
}

/* ---------------- Login ---------------- */
#LoginCard {
    background-color: {{surface}};
    border-radius: 22px;
    border: 1px solid {{border}};
}
#LoginTitle { font-size: 26px; font-weight: 700; color: {{text}}; background: transparent; }
#LoginSub { font-size: 14px; color: {{muted}}; background: transparent; }
#LoginHint {
    color: #0A6B61; background: #E3F6F3; border-radius: 8px;
    padding: 8px 12px; font-size: 12px;
}

/* ---------------- Timeline ---------------- */
QFrame#TimelineItem {
    background-color: {{surface}};
    border: 1px solid {{border}};
    border-radius: 14px;
}
QFrame#TimelineItem:hover { border: 1px solid #9FD8D1; }
QLabel#TimelineDate { color: #0E9F8E; font-weight: 700; font-size: 13px; background: transparent; }
QLabel#TimelineTitle { font-weight: 700; font-size: 16px; color: {{text}}; background: transparent; }
QLabel#TimelineNotes { color: {{muted}}; font-size: 13px; background: transparent; }
QLabel#TimelineCost {
    color: #0A6B61; font-weight: 700; background:#E3F6F3;
    padding: 3px 10px; border-radius: 8px;
}

/* ---------------- Misc chips/badges ---------------- */
QLabel#Badge {
    background:#E3F6F3; color:#0A6B61; padding:5px 12px;
    border-radius: 10px; font-weight:700;
}
QLabel#Pill {
    background:{{chip_bg}}; color:{{chip_text}}; padding:4px 10px;
    border-radius: 9px; font-size:12px;
}
